---
import { formatDate, getCategorySlug } from '@/utils/helpers';
import { getReadingTime, formatReadingTime } from '@/utils/reading-time';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  heroImage?: string;
  category: string;
  author: string;
  slug: string;
  body?: string;
}

const { title, description, pubDate, heroImage, category, author, slug, body = '' } = Astro.props;
const readingTime = getReadingTime(body);
const categorySlug = getCategorySlug(category);
---

<article class="featured-post">
  <div class="featured-grid">
    <div class="image-container">
      <a href={`/blog/${slug}`} class="image-link" aria-label={title}>
        {heroImage ? (
          <img src={heroImage} alt={title} loading="eager" class="hero-image" />
        ) : (
          <div class="placeholder-image"></div>
        )}
      </a>
      <span class="featured-tag">Featured Story</span>
    </div>
    
    <div class="content-container">
      <div class="meta-top">
        <a href={`/category/${categorySlug}`} class="category-pill">{category}</a>
        <span class="dot">&bull;</span>
        <span class="reading-time">{formatReadingTime(readingTime)}</span>
      </div>
      
      <a href={`/blog/${slug}`} class="title-link">
        <h2 class="title">{title}</h2>
      </a>
      
      <p class="description">{description}</p>
      
      <div class="meta-bottom">
        <div class="author-info">
          <div class="author-avatar">{author.charAt(0)}</div>
          <div>
            <span class="author-name">{author}</span>
            <time datetime={pubDate.toISOString()} class="publish-date">{formatDate(pubDate)}</time>
          </div>
        </div>
        
        <a href={`/blog/${slug}`} class="read-btn">
          Read Article
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </div>
</article>

<style>
  .featured-post {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 1.25rem;
    overflow: hidden;
    box-shadow: 0 4px 20px -2px var(--color-shadow);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    margin-bottom: 2.5rem;
  }

  .featured-post:hover {
    box-shadow: 0 16px 32px -4px rgba(99, 102, 241, 0.12);
    border-color: rgba(99, 102, 241, 0.4);
  }

  .featured-grid {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 860px) {
    .featured-grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    }
  }

  .image-container {
    position: relative;
    overflow: hidden;
    background: #0f172a;
    min-height: 240px;
  }

  @media (min-width: 860px) {
    .image-container {
      min-height: 320px;
      height: 100%;
    }
  }

  .image-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .featured-post:hover .hero-image {
    transform: scale(1.04);
  }

  .placeholder-image {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #1e1b4b, #4338ca);
  }

  .featured-tag {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: rgba(15, 23, 42, 0.85);
    color: #f8fafc;
    backdrop-filter: blur(8px);
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.25);
  }

  .content-container {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-width: 0;
  }

  @media (min-width: 640px) {
    .content-container {
      padding: 2.25rem;
    }
  }

  .meta-top {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.85rem;
    font-size: 0.825rem;
  }

  .category-pill {
    display: inline-flex;
    align-items: center;
    background: rgba(99, 102, 241, 0.12);
    color: var(--color-accent);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-weight: 600;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.75rem;
    transition: background 0.2s, color 0.2s;
  }

  .category-pill:hover {
    background: var(--color-accent);
    color: white;
    text-decoration: none;
  }

  .dot {
    color: var(--color-text-muted);
    opacity: 0.5;
  }

  .reading-time {
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .title-link {
    color: inherit;
    text-decoration: none;
  }

  .title-link:hover {
    text-decoration: none;
  }

  .title-link:hover .title {
    color: var(--color-accent);
  }

  .title {
    margin: 0 0 0.85rem;
    font-size: clamp(1.35rem, 2.3vw, 1.85rem);
    line-height: 1.25;
    font-weight: 800;
    transition: color 0.2s;
    word-break: break-word;
  }

  .description {
    color: var(--color-text-muted);
    font-size: 0.975rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .meta-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
    margin-top: auto;
  }

  .author-info {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .author-avatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-accent), #8b5cf6);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.85rem;
  }

  .author-name {
    display: block;
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--color-text);
    line-height: 1.2;
  }

  .publish-date {
    display: block;
    font-size: 0.775rem;
    color: var(--color-text-muted);
  }

  .read-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--color-accent);
    text-decoration: none;
    padding: 0.4rem 0.85rem;
    border-radius: 0.5rem;
    background: rgba(99, 102, 241, 0.08);
    transition: all 0.2s ease;
  }

  .read-btn svg {
    transition: transform 0.2s ease;
  }

  .read-btn:hover {
    background: var(--color-accent);
    color: white;
    text-decoration: none;
  }

  .read-btn:hover svg {
    transform: translateX(3px);
  }
</style>

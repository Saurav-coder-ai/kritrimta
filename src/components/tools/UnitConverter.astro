---
// UnitConverter.astro - Multi-category instant client-side unit converter
---

<div class="unit-converter-app">
  <!-- Category Selector Tabs -->
  <div class="category-tabs-container">
    <div class="category-tabs" id="uc-category-tabs">
      <button type="button" class="tab-btn active" data-cat="length">Length</button>
      <button type="button" class="tab-btn" data-cat="mass">Weight / Mass</button>
      <button type="button" class="tab-btn" data-cat="temperature">Temperature</button>
      <button type="button" class="tab-btn" data-cat="area">Area</button>
      <button type="button" class="tab-btn" data-cat="volume">Volume</button>
      <button type="button" class="tab-btn" data-cat="speed">Speed</button>
      <button type="button" class="tab-btn" data-cat="time">Time</button>
      <button type="button" class="tab-btn" data-cat="storage">Data Storage</button>
    </div>
  </div>

  <!-- Interactive Conversion Stage -->
  <div class="converter-stage">
    <!-- From Column -->
    <div class="conversion-column">
      <label class="col-label" for="uc-from-input">FROM</label>
      <div class="input-unit-group">
        <input
          type="number"
          id="uc-from-input"
          class="form-input unit-input"
          placeholder="Enter value"
          value="1"
          step="any"
        />
        <select id="uc-from-select" class="form-input unit-select" aria-label="From Unit"></select>
      </div>
    </div>

    <!-- Swap Action Button -->
    <button type="button" id="uc-swap-btn" class="btn-swap-units" aria-label="Swap units">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="16 3 21 3 21 8"></polyline>
        <line x1="4" y1="20" x2="21" y2="3"></line>
        <polyline points="8 21 3 21 3 16"></polyline>
        <line x1="20" y1="4" x2="3" y2="21"></line>
      </svg>
    </button>

    <!-- To Column -->
    <div class="conversion-column">
      <label class="col-label" for="uc-to-input">TO</label>
      <div class="input-unit-group">
        <input
          type="number"
          id="uc-to-input"
          class="form-input unit-input result-highlight"
          placeholder="Result"
          step="any"
        />
        <select id="uc-to-select" class="form-input unit-select" aria-label="To Unit"></select>
      </div>
    </div>
  </div>

  <!-- Formula & Conversion Reference Summary Box -->
  <div class="formula-box">
    <div class="formula-details">
      <span class="formula-label">Formula / Conversion Factor:</span>
      <span class="formula-value" id="uc-formula-text">1 Meter = 3.28084 Feet</span>
    </div>
    <button type="button" class="btn-copy-result" id="uc-copy-result-btn">
      Copy Result
    </button>
  </div>
</div>

<style>
  .unit-converter-app {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .category-tabs-container {
    overflow-x: auto;
    padding-bottom: 0.25rem;
    scrollbar-width: thin;
  }

  .category-tabs {
    display: flex;
    gap: 0.5rem;
    min-width: max-content;
  }

  .tab-btn {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    padding: 0.55rem 1rem;
    border-radius: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .tab-btn:hover {
    color: var(--color-text);
    border-color: var(--color-accent);
  }

  .tab-btn.active {
    background: var(--color-accent);
    color: #ffffff;
    border-color: var(--color-accent);
    box-shadow: 0 2px 8px rgba(217, 78, 40, 0.25);
  }

  .converter-stage {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    align-items: center;
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 1.5rem;
  }

  @media (min-width: 768px) {
    .converter-stage {
      grid-template-columns: 1fr auto 1fr;
      gap: 1.5rem;
    }
  }

  .conversion-column {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .col-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  .input-unit-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  @media (min-width: 480px) {
    .input-unit-group {
      flex-direction: row;
    }
  }

  .unit-input {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 700;
    padding: 0.75rem 1rem;
    flex: 1;
  }

  .unit-input.result-highlight {
    background: var(--color-bg);
    color: var(--color-accent);
  }

  .unit-select {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 500;
    padding: 0.75rem;
    min-width: 140px;
    cursor: pointer;
  }

  .btn-swap-units {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    margin: 0 auto;
    transition: all 0.2s ease;
  }

  .btn-swap-units:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    transform: rotate(180deg);
  }

  .formula-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 0.85rem 1.25rem;
  }

  .formula-details {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .formula-label {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .formula-value {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .btn-copy-result {
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    padding: 0.4rem 0.85rem;
    border-radius: 0.4rem;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-copy-result:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
</style>

<script>
  interface UnitCategory {
    name: string;
    units: { [key: string]: { label: string; factor?: number } };
    defaultFrom: string;
    defaultTo: string;
    convert?: (val: number, from: string, to: string) => number;
  }

  const UNIT_DATA: { [key: string]: UnitCategory } = {
    length: {
      name: 'Length',
      defaultFrom: 'm',
      defaultTo: 'ft',
      units: {
        km: { label: 'Kilometers (km)', factor: 1000 },
        m: { label: 'Meters (m)', factor: 1 },
        cm: { label: 'Centimeters (cm)', factor: 0.01 },
        mm: { label: 'Millimeters (mm)', factor: 0.001 },
        mi: { label: 'Miles (mi)', factor: 1609.344 },
        yd: { label: 'Yards (yd)', factor: 0.9144 },
        ft: { label: 'Feet (ft)', factor: 0.3048 },
        in: { label: 'Inches (in)', factor: 0.0254 },
        nm: { label: 'Nautical Miles', factor: 1852 }
      }
    },
    mass: {
      name: 'Weight / Mass',
      defaultFrom: 'kg',
      defaultTo: 'lb',
      units: {
        mt: { label: 'Metric Ton (t)', factor: 1000 },
        kg: { label: 'Kilograms (kg)', factor: 1 },
        g: { label: 'Grams (g)', factor: 0.001 },
        mg: { label: 'Milligrams (mg)', factor: 0.000001 },
        lb: { label: 'Pounds (lbs)', factor: 0.45359237 },
        oz: { label: 'Ounces (oz)', factor: 0.028349523125 },
        st: { label: 'Stone (st)', factor: 6.35029318 }
      }
    },
    temperature: {
      name: 'Temperature',
      defaultFrom: 'c',
      defaultTo: 'f',
      units: {
        c: { label: 'Celsius (°C)' },
        f: { label: 'Fahrenheit (°F)' },
        k: { label: 'Kelvin (K)' }
      },
      convert: (val: number, from: string, to: string): number => {
        if (from === to) return val;
        // Convert to Celsius first
        let celsius = val;
        if (from === 'f') celsius = (val - 32) * (5 / 9);
        else if (from === 'k') celsius = val - 273.15;

        // Convert Celsius to Target
        if (to === 'c') return celsius;
        if (to === 'f') return celsius * (9 / 5) + 32;
        if (to === 'k') return celsius + 273.15;
        return val;
      }
    },
    area: {
      name: 'Area',
      defaultFrom: 'sqm',
      defaultTo: 'sqft',
      units: {
        sqkm: { label: 'Square Kilometers (km²)', factor: 1000000 },
        sqm: { label: 'Square Meters (m²)', factor: 1 },
        sqcm: { label: 'Square Centimeters (cm²)', factor: 0.0001 },
        sqmi: { label: 'Square Miles (mi²)', factor: 2589988.110336 },
        sqyd: { label: 'Square Yards (yd²)', factor: 0.83612736 },
        sqft: { label: 'Square Feet (ft²)', factor: 0.09290304 },
        sqin: { label: 'Square Inches (in²)', factor: 0.00064516 },
        ha: { label: 'Hectares (ha)', factor: 10000 },
        acre: { label: 'Acres (ac)', factor: 4046.8564224 }
      }
    },
    volume: {
      name: 'Volume',
      defaultFrom: 'l',
      defaultTo: 'gal',
      units: {
        cum: { label: 'Cubic Meters (m³)', factor: 1000 },
        l: { label: 'Liters (L)', factor: 1 },
        ml: { label: 'Milliliters (mL)', factor: 0.001 },
        gal: { label: 'US Gallons (gal)', factor: 3.785411784 },
        qt: { label: 'US Quarts (qt)', factor: 0.946352946 },
        pt: { label: 'US Pints (pt)', factor: 0.473176473 },
        cup: { label: 'US Cups', factor: 0.24 },
        floz: { label: 'Fluid Ounces (fl oz)', factor: 0.0295735295625 }
      }
    },
    speed: {
      name: 'Speed',
      defaultFrom: 'kmh',
      defaultTo: 'mph',
      units: {
        mps: { label: 'Meters / sec (m/s)', factor: 1 },
        kmh: { label: 'Kilometers / hr (km/h)', factor: 0.2777777778 },
        mph: { label: 'Miles / hr (mph)', factor: 0.44704 },
        knot: { label: 'Knots (kn)', factor: 0.5144444444 },
        fps: { label: 'Feet / sec (ft/s)', factor: 0.3048 }
      }
    },
    time: {
      name: 'Time',
      defaultFrom: 'hr',
      defaultTo: 'min',
      units: {
        ms: { label: 'Milliseconds (ms)', factor: 0.001 },
        s: { label: 'Seconds (s)', factor: 1 },
        min: { label: 'Minutes (min)', factor: 60 },
        hr: { label: 'Hours (hr)', factor: 3600 },
        day: { label: 'Days (d)', factor: 86400 },
        wk: { label: 'Weeks (wk)', factor: 604800 },
        yr: { label: 'Years (365d)', factor: 31536000 }
      }
    },
    storage: {
      name: 'Data Storage',
      defaultFrom: 'gb',
      defaultTo: 'mb',
      units: {
        b: { label: 'Bytes (B)', factor: 1 },
        kb: { label: 'Kilobytes (KB)', factor: 1024 },
        mb: { label: 'Megabytes (MB)', factor: 1048576 },
        gb: { label: 'Gigabytes (GB)', factor: 1073741824 },
        tb: { label: 'Terabytes (TB)', factor: 1099511627776 },
        pb: { label: 'Petabytes (PB)', factor: 1125899906842624 }
      }
    }
  };

  let currentCategory = 'length';

  const tabButtons = document.querySelectorAll('#uc-category-tabs .tab-btn');
  const fromInput = document.getElementById('uc-from-input') as HTMLInputElement | null;
  const toInput = document.getElementById('uc-to-input') as HTMLInputElement | null;
  const fromSelect = document.getElementById('uc-from-select') as HTMLSelectElement | null;
  const toSelect = document.getElementById('uc-to-select') as HTMLSelectElement | null;
  const swapBtn = document.getElementById('uc-swap-btn');
  const formulaText = document.getElementById('uc-formula-text');
  const copyResultBtn = document.getElementById('uc-copy-result-btn');

  function populateUnitSelects(categoryKey: string) {
    const cat = UNIT_DATA[categoryKey];
    if (!cat || !fromSelect || !toSelect) return;

    fromSelect.innerHTML = '';
    toSelect.innerHTML = '';

    Object.entries(cat.units).forEach(([key, val]) => {
      const opt1 = document.createElement('option');
      opt1.value = key;
      opt1.textContent = val.label;
      fromSelect.appendChild(opt1);

      const opt2 = document.createElement('option');
      opt2.value = key;
      opt2.textContent = val.label;
      toSelect.appendChild(opt2);
    });

    fromSelect.value = cat.defaultFrom;
    toSelect.value = cat.defaultTo;
  }

  function formatOutput(num: number): string {
    if (isNaN(num)) return '';
    if (Math.abs(num) < 0.000001 && num !== 0) {
      return num.toExponential(6);
    }
    // Round to max 6 decimal places cleanly
    return parseFloat(num.toFixed(6)).toString();
  }

  function calculate(fromActive: boolean = true) {
    const cat = UNIT_DATA[currentCategory];
    if (!cat || !fromInput || !toInput || !fromSelect || !toSelect) return;

    const fromUnit = fromSelect.value;
    const toUnit = toSelect.value;

    if (fromActive) {
      const val = parseFloat(fromInput.value);
      if (isNaN(val)) {
        toInput.value = '';
        return;
      }

      let result = 0;
      if (cat.convert) {
        result = cat.convert(val, fromUnit, toUnit);
      } else {
        const fromFactor = cat.units[fromUnit].factor || 1;
        const toFactor = cat.units[toUnit].factor || 1;
        result = (val * fromFactor) / toFactor;
      }

      toInput.value = formatOutput(result);
    } else {
      const val = parseFloat(toInput.value);
      if (isNaN(val)) {
        fromInput.value = '';
        return;
      }

      let result = 0;
      if (cat.convert) {
        result = cat.convert(val, toUnit, fromUnit);
      } else {
        const fromFactor = cat.units[fromUnit].factor || 1;
        const toFactor = cat.units[toUnit].factor || 1;
        result = (val * toFactor) / fromFactor;
      }

      fromInput.value = formatOutput(result);
    }

    // Update formula text summary
    if (formulaText) {
      if (cat.convert) {
        if (currentCategory === 'temperature') {
          if (fromUnit === 'c' && toUnit === 'f') formulaText.textContent = '°F = (°C × 9/5) + 32';
          else if (fromUnit === 'f' && toUnit === 'c') formulaText.textContent = '°C = (°F − 32) × 5/9';
          else if (fromUnit === 'c' && toUnit === 'k') formulaText.textContent = 'K = °C + 273.15';
          else if (fromUnit === 'k' && toUnit === 'c') formulaText.textContent = '°C = K − 273.15';
          else formulaText.textContent = `1 ${cat.units[fromUnit].label} = ${formatOutput(cat.convert(1, fromUnit, toUnit))} ${cat.units[toUnit].label}`;
        }
      } else {
        const fromFactor = cat.units[fromUnit].factor || 1;
        const toFactor = cat.units[toUnit].factor || 1;
        const ratio = fromFactor / toFactor;
        formulaText.textContent = `1 ${cat.units[fromUnit].label.split(' ')[0]} = ${formatOutput(ratio)} ${cat.units[toUnit].label.split(' ')[0]}`;
      }
    }
  }

  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      tabButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const catKey = btn.getAttribute('data-cat') || 'length';
      currentCategory = catKey;
      populateUnitSelects(catKey);
      calculate(true);
    });
  });

  fromInput?.addEventListener('input', () => calculate(true));
  toInput?.addEventListener('input', () => calculate(false));
  fromSelect?.addEventListener('change', () => calculate(true));
  toSelect?.addEventListener('change', () => calculate(true));

  swapBtn?.addEventListener('click', () => {
    if (!fromSelect || !toSelect || !fromInput || !toInput) return;
    const temp = fromSelect.value;
    fromSelect.value = toSelect.value;
    toSelect.value = temp;
    calculate(true);
  });

  copyResultBtn?.addEventListener('click', async () => {
    if (!toInput || !toInput.value) return;
    try {
      const unitLabel = toSelect?.options[toSelect.selectedIndex].text || '';
      await navigator.clipboard.writeText(`${toInput.value} ${unitLabel}`);
      const orig = copyResultBtn.textContent;
      copyResultBtn.textContent = 'Copied! ✓';
      setTimeout(() => {
        if (copyResultBtn) copyResultBtn.textContent = orig;
      }, 2000);
    } catch (e) {
      console.error('Failed to copy', e);
    }
  });

  // Init
  populateUnitSelects('length');
  calculate(true);
</script>

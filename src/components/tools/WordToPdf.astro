---
// WordToPdf.astro - Client-side Word (.docx) to PDF Converter
---

<div class="word-to-pdf-app">
  <!-- Privacy & Quality Notice Banner -->
  <div class="quality-notice-banner">
    <div class="notice-icon">🔒</div>
    <div class="notice-content">
      <strong>100% Client-Side Conversion:</strong> Your Word documents are parsed and converted to PDF directly inside your browser. No files are uploaded to remote servers, ensuring absolute privacy for sensitive contracts, reports, and academic papers.
    </div>
  </div>

  <!-- Upload Dropzone -->
  <div class="dropzone-area" id="word-dropzone">
    <input
      type="file"
      id="word-file-input"
      accept=".docx,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      class="file-input-hidden"
    />
    <div class="dropzone-content">
      <div class="dropzone-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
          <polyline points="10 9 9 9 8 9"></polyline>
        </svg>
      </div>
      <p class="dropzone-prompt"><strong>Click to select a Word (.docx) file</strong> or drag and drop here</p>
      <p class="dropzone-note">Supports Microsoft Word (.docx) documents up to 25MB</p>
    </div>
  </div>

  <!-- PDF Layout Settings Toolbar -->
  <div class="pdf-options-bar">
    <div class="option-item">
      <label for="w2p-page-size" class="option-label">PAGE SIZE</label>
      <select id="w2p-page-size" class="form-input option-select">
        <option value="a4" selected>A4 (210 × 297 mm)</option>
        <option value="letter">US Letter (8.5 × 11 in)</option>
      </select>
    </div>

    <div class="option-item">
      <label for="w2p-orientation" class="option-label">ORIENTATION</label>
      <select id="w2p-orientation" class="form-input option-select">
        <option value="portrait" selected>Portrait</option>
        <option value="landscape">Landscape</option>
      </select>
    </div>

    <div class="option-item">
      <label for="w2p-margin" class="option-label">PAGE MARGINS</label>
      <select id="w2p-margin" class="form-input option-select">
        <option value="10">Compact (10 mm)</option>
        <option value="15" selected>Standard (15 mm)</option>
        <option value="20">Wide (20 mm)</option>
      </select>
    </div>
  </div>

  <!-- Selected Word File Card -->
  <div class="selected-file-card" id="word-meta-card" style="display: none;">
    <div class="file-icon-badge">DOCX</div>
    <div class="file-details">
      <span class="file-name" id="word-file-name">document.docx</span>
      <span class="file-info" id="word-file-stats">Ready for conversion</span>
    </div>
    <button type="button" class="btn-tool-action danger" id="word-remove-btn" title="Remove Word file">✕ Remove</button>
  </div>

  <!-- Document Preview Container -->
  <div class="document-preview-section" id="word-preview-section" style="display: none;">
    <div class="preview-header">
      <span class="preview-title">Document Preview</span>
      <span class="preview-subtitle">Formatting converted from Word styles</span>
    </div>
    <div class="preview-viewport" id="word-preview-content">
      <!-- Converted HTML preview will be injected here -->
    </div>
  </div>

  <!-- Progress Bar Box -->
  <div id="word-progress-container" class="progress-box" style="display: none;">
    <div class="progress-bar-bg">
      <div id="word-progress-bar" class="progress-bar-fill"></div>
    </div>
    <span id="word-progress-label" class="progress-label">Converting document to PDF...</span>
  </div>

  <!-- Warning / Error Notification -->
  <div id="word-warning-box" class="warning-box" style="display: none;"></div>

  <!-- Main Convert Action -->
  <div class="convert-actions-bar">
    <button type="button" id="word-convert-btn" class="btn btn-primary btn-convert-pdf" disabled>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
        <polyline points="14 2 14 8 20 8"></polyline>
        <line x1="12" y1="18" x2="12" y2="12"></line>
        <line x1="9" y1="15" x2="15" y2="15"></line>
      </svg>
      <span>Convert to PDF &amp; Download</span>
    </button>
  </div>
</div>

<style>
  .word-to-pdf-app {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .quality-notice-banner {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 0.85rem 1rem;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .notice-icon {
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .notice-content strong {
    color: var(--color-text);
  }

  .dropzone-area {
    border: 2px dashed var(--color-border);
    border-radius: 0.75rem;
    padding: 2.75rem 1.5rem;
    text-align: center;
    background: var(--color-bg);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .dropzone-area:hover,
  .dropzone-area.drag-over {
    border-color: var(--color-accent);
    background: var(--color-accent-subtle);
  }

  .file-input-hidden {
    display: none;
  }

  .dropzone-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }

  .dropzone-icon {
    color: var(--color-accent);
    margin-bottom: 0.25rem;
  }

  .dropzone-prompt {
    font-size: 1.05rem;
    color: var(--color-text);
  }

  .dropzone-note {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .pdf-options-bar {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: 0.6rem;
    padding: 1.15rem 1.25rem;
  }

  @media (min-width: 640px) {
    .pdf-options-bar {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .option-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .option-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .option-select {
    font-size: 0.88rem;
    padding: 0.6rem;
    cursor: pointer;
  }

  .selected-file-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: 0.6rem;
    padding: 1rem 1.25rem;
  }

  .file-icon-badge {
    background: #2563eb;
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.4rem 0.65rem;
    border-radius: 0.4rem;
    letter-spacing: 0.05em;
  }

  .file-details {
    display: flex;
    flex-direction: column;
    flex: 1;
    overflow: hidden;
  }

  .file-name {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .file-info {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .btn-tool-action {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    padding: 0.35rem 0.75rem;
    border-radius: 0.4rem;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-tool-action.danger:hover {
    border-color: #ef4444;
    color: #ef4444;
  }

  .document-preview-section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .preview-header {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  .preview-title {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .preview-subtitle {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .preview-viewport {
    max-height: 380px;
    overflow-y: auto;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.6rem;
    padding: 1.5rem;
    color: var(--color-text);
    font-family: var(--font-sans);
    line-height: 1.6;
    font-size: 0.95rem;
  }

  .preview-viewport h1,
  .preview-viewport h2,
  .preview-viewport h3 {
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .preview-viewport p {
    margin-bottom: 0.85rem;
  }

  .preview-viewport table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
  }

  .preview-viewport td,
  .preview-viewport th {
    border: 1px solid var(--color-border);
    padding: 0.5rem 0.75rem;
  }

  .warning-box {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid #ef4444;
    color: #ef4444;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    font-size: 0.85rem;
  }

  .progress-box {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .progress-bar-bg {
    width: 100%;
    height: 8px;
    background: var(--color-surface-subtle);
    border-radius: 9999px;
    overflow: hidden;
  }

  .progress-bar-fill {
    height: 100%;
    width: 0%;
    background: var(--color-accent);
    transition: width 0.2s ease;
  }

  .progress-label {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-muted);
    text-align: center;
  }

  .convert-actions-bar {
    display: flex;
    justify-content: center;
  }

  .btn-convert-pdf {
    width: 100%;
    max-width: 400px;
    padding: 0.85rem 1.5rem;
    font-size: 1rem;
  }

  .btn-convert-pdf:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none !important;
  }
</style>

<script>
  let currentFile: File | null = null;
  let parsedHtmlContent: string = '';

  const dropzone = document.getElementById('word-dropzone');
  const fileInput = document.getElementById('word-file-input') as HTMLInputElement | null;
  const metaCard = document.getElementById('word-meta-card');
  const fileNameEl = document.getElementById('word-file-name');
  const fileStatsEl = document.getElementById('word-file-stats');
  const removeBtn = document.getElementById('word-remove-btn');
  const previewSection = document.getElementById('word-preview-section');
  const previewContent = document.getElementById('word-preview-content');
  const convertBtn = document.getElementById('word-convert-btn') as HTMLButtonElement | null;
  const warningBox = document.getElementById('word-warning-box');
  const progressContainer = document.getElementById('word-progress-container');
  const progressBar = document.getElementById('word-progress-bar');
  const progressLabel = document.getElementById('word-progress-label');

  const pageSizeSelect = document.getElementById('w2p-page-size') as HTMLSelectElement | null;
  const orientationSelect = document.getElementById('w2p-orientation') as HTMLSelectElement | null;
  const marginSelect = document.getElementById('w2p-margin') as HTMLSelectElement | null;

  function formatBytes(bytes: number): string {
    if (bytes < 1024) return `${bytes} B`;
    if (bytes < 1048576) return `${(bytes / 1024).toFixed(1)} KB`;
    return `${(bytes / 1048576).toFixed(1)} MB`;
  }

  function showWarning(msg: string | null) {
    if (!warningBox) return;
    if (msg) {
      warningBox.textContent = msg;
      warningBox.style.display = 'block';
    } else {
      warningBox.style.display = 'none';
    }
  }

  async function handleSelectedFile(file: File) {
    showWarning(null);
    if (!file.name.toLowerCase().endsWith('.docx')) {
      showWarning('Unsupported format. Please select a valid Word (.docx) document.');
      return;
    }

    currentFile = file;
    if (fileNameEl) fileNameEl.textContent = file.name;
    if (fileStatsEl) fileStatsEl.textContent = `${formatBytes(file.size)} • Parsing document...`;
    if (metaCard) metaCard.style.display = 'flex';

    try {
      const buffer = await file.arrayBuffer();
      // Lazy-load mammoth
      const mammoth = await import('mammoth');
      const result = await mammoth.convertToHtml(
        { arrayBuffer: buffer },
        {
          convertImage: mammoth.images.imgElement(function(image: any) {
            return image.read('base64').then(function(imageBuffer: string) {
              return {
                src: 'data:' + image.contentType + ';base64,' + imageBuffer
              };
            });
          })
        }
      );
      parsedHtmlContent = result.value || '<p>No readable content found in document.</p>';

      if (previewContent) {
        previewContent.innerHTML = parsedHtmlContent;
      }
      if (previewSection) previewSection.style.display = 'flex';
      if (fileStatsEl) fileStatsEl.textContent = `${formatBytes(file.size)} • Ready for PDF conversion`;
      if (convertBtn) convertBtn.disabled = false;
    } catch (err: any) {
      console.error('Mammoth parsing error:', err);
      showWarning('Unable to parse Word document. Please ensure it is a valid .docx file.');
      if (fileStatsEl) fileStatsEl.textContent = 'Parsing failed';
    }
  }

  dropzone?.addEventListener('click', () => fileInput?.click());

  fileInput?.addEventListener('change', (e) => {
    const target = e.target as HTMLInputElement;
    if (target.files && target.files[0]) {
      handleSelectedFile(target.files[0]);
      target.value = '';
    }
  });

  dropzone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.classList.add('drag-over');
  });

  ['dragleave', 'dragend'].forEach(type => {
    dropzone?.addEventListener(type, () => dropzone.classList.remove('drag-over'));
  });

  dropzone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('drag-over');
    if (e.dataTransfer && e.dataTransfer.files.length > 0) {
      handleSelectedFile(e.dataTransfer.files[0]);
    }
  });

  removeBtn?.addEventListener('click', () => {
    currentFile = null;
    parsedHtmlContent = '';
    if (metaCard) metaCard.style.display = 'none';
    if (previewSection) previewSection.style.display = 'none';
    if (convertBtn) convertBtn.disabled = true;
    showWarning(null);
  });

  // Generate PDF from Word HTML using jsPDF
  async function convertWordToPdf() {
    if (!currentFile || !parsedHtmlContent || !convertBtn || !progressContainer || !progressBar || !progressLabel) return;

    convertBtn.disabled = true;
    progressContainer.style.display = 'flex';
    progressBar.style.width = '15%';
    progressLabel.textContent = 'Initializing PDF engine...';

    try {
      const { jsPDF } = await import('jspdf');

      const pageSize = pageSizeSelect?.value || 'a4';
      const orientation = (orientationSelect?.value || 'portrait') as 'portrait' | 'landscape';
      const marginMm = parseInt(marginSelect?.value || '15', 10);

      const doc = new jsPDF({
        orientation: orientation === 'landscape' ? 'l' : 'p',
        unit: 'mm',
        format: pageSize === 'letter' ? 'letter' : 'a4'
      });

      progressBar.style.width = '45%';
      progressLabel.textContent = 'Rendering typography & pages into PDF...';

      // Create a clean offscreen wrapper for accurate print layout
      const printWrapper = document.createElement('div');
      printWrapper.style.width = pageSize === 'letter' ? '816px' : '794px'; // ~A4 print px
      printWrapper.style.padding = `${marginMm * 3.78}px`;
      printWrapper.style.color = '#111827';
      printWrapper.style.background = '#ffffff';
      printWrapper.style.fontFamily = "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif";
      printWrapper.style.fontSize = '14px';
      printWrapper.style.lineHeight = '1.6';
      printWrapper.innerHTML = parsedHtmlContent;

      document.body.appendChild(printWrapper);

      progressBar.style.width = '70%';
      progressLabel.textContent = 'Generating PDF pages...';

      await doc.html(printWrapper, {
        callback: (pdfDoc) => {
          progressBar.style.width = '100%';
          progressLabel.textContent = 'Download started!';

          const baseName = currentFile?.name.replace(/\.docx$/i, '') || 'converted_document';
          pdfDoc.save(`${baseName}.pdf`);

          if (document.body.contains(printWrapper)) {
            document.body.removeChild(printWrapper);
          }

          setTimeout(() => {
            progressContainer.style.display = 'none';
            convertBtn.disabled = false;
            progressBar.style.width = '0%';
          }, 2500);
        },
        x: marginMm,
        y: marginMm,
        width: doc.internal.pageSize.getWidth() - (marginMm * 2),
        windowWidth: pageSize === 'letter' ? 816 : 794
      });

    } catch (err: any) {
      console.error('Word to PDF Error:', err);
      showWarning(`PDF Generation Error: ${err?.message || 'Failed to render PDF.'}`);
      progressContainer.style.display = 'none';
      convertBtn.disabled = false;
    }
  }

  convertBtn?.addEventListener('click', convertWordToPdf);
</script>

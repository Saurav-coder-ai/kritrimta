---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FeaturedPost from '@/components/FeaturedPost.astro';
import PostCard from '@/components/PostCard.astro';
import CategoryList from '@/components/CategoryList.astro';
import Newsletter from '@/components/Newsletter.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Lead story: first post with featured=true, or most recent
const featuredPost = sortedPosts.find(p => p.data.featured) || sortedPosts[0];
const remainingPosts = sortedPosts.filter(p => p.id !== featuredPost?.id);

// Spotlight story & standard stories for varied layout rhythm
const spotlightPost = remainingPosts[0];
const secondaryPosts = remainingPosts.slice(1);
---

<BaseLayout
  title="Kritrimta"
  description="An independent journal of artificial intelligence, high-performance computing, and hardware engineering. Edited by Saurav Karki."
>
  <!-- Masthead / Editorial Hero Section -->
  <section class="masthead-section">
    <div class="container">
      <div class="masthead-meta">
        <span class="masthead-tag">KRITRIMTA JOURNAL // EST. 2026</span>
        <span class="masthead-divider">&bull;</span>
        <span class="masthead-editor">EDITED BY SAURAV KARKI</span>
        <span class="masthead-divider">&bull;</span>
        <span class="masthead-status">AUTONOMOUS COMPUTING & SILICON</span>
      </div>

      <div class="masthead-content">
        <h1 class="masthead-title">
          Analysis, Benchmarks &amp; <span class="accent-gradient">First Principles</span> in Artificial Intelligence.
        </h1>
        <p class="masthead-mission">
          An independent publication examining the engineering realities, model economics, and silicon architectures behind modern computing systems. Uncompromised by corporate PR.
        </p>
      </div>

      <div class="masthead-rule"></div>
    </div>
  </section>

  <!-- Lead Story (Featured Article) -->
  {featuredPost && (
    <section class="lead-story-section">
      <div class="container">
        <div class="section-kicker-bar">
          <span class="kicker-label">LEAD INVESTIGATION</span>
          <span class="kicker-line"></span>
        </div>
        <FeaturedPost
          title={featuredPost.data.title}
          description={featuredPost.data.description}
          pubDate={featuredPost.data.pubDate}
          heroImage={featuredPost.data.heroImage}
          category={featuredPost.data.category}
          author={featuredPost.data.author}
          slug={featuredPost.id}
          body={featuredPost.body || ''}
        />
      </div>
    </section>
  )}

  <!-- Topic Navigator -->
  <section class="topic-index-section">
    <div class="container">
      <div class="section-kicker-bar">
        <span class="kicker-label">JOURNAL SECTIONS</span>
        <span class="kicker-line"></span>
      </div>
      <CategoryList />
    </div>
  </section>

  <!-- Asymmetric Editorial Grid for Recent Coverage -->
  {remainingPosts.length > 0 && (
    <section class="dispatches-section">
      <div class="container">
        <div class="section-kicker-bar">
          <span class="kicker-label">RECENT DISPATCHES & BENCHMARKS</span>
          <span class="kicker-line"></span>
        </div>

        <div class="asymmetric-feed">
          <!-- Main spotlight card (wider / prominent) -->
          {spotlightPost && (
            <div class="spotlight-block">
              <PostCard
                title={spotlightPost.data.title}
                description={spotlightPost.data.description}
                pubDate={spotlightPost.data.pubDate}
                heroImage={spotlightPost.data.heroImage}
                category={spotlightPost.data.category}
                slug={spotlightPost.id}
                body={spotlightPost.body || ''}
                author={spotlightPost.data.author}
                layout="horizontal"
              />
            </div>
          )}

          <!-- Secondary stories grid -->
          {secondaryPosts.length > 0 && (
            <div class="secondary-grid">
              {secondaryPosts.map(post => (
                <PostCard
                  title={post.data.title}
                  description={post.data.description}
                  pubDate={post.data.pubDate}
                  heroImage={post.data.heroImage}
                  category={post.data.category}
                  slug={post.id}
                  body={post.body || ''}
                  author={post.data.author}
                  layout="standard"
                />
              ))}
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- Featured Utility Tools Section -->
  <section class="tools-showcase-section">
    <div class="container">
      <div class="section-kicker-bar">
        <span class="kicker-label">CLIENT-SIDE UTILITIES</span>
        <span class="kicker-line"></span>
      </div>

      <div class="tools-showcase-header">
        <div>
          <h2 class="showcase-title">Fast, Private &amp; Free Online Tools</h2>
          <p class="showcase-subtitle">Zero server latency, complete client-side privacy, and instant conversion results.</p>
        </div>
        <a href="/tools" class="btn btn-outline btn-tools-all">View All 6 Tools &rarr;</a>
      </div>

      <div class="tools-mini-grid">
        <a href="/tools/word-counter" class="tool-mini-card">
          <span class="tool-mini-icon">📝</span>
          <div class="tool-mini-info">
            <h3>Word Counter</h3>
            <p>Word, character, reading duration & keyword density stats.</p>
          </div>
        </a>

        <a href="/tools/case-converter" class="tool-mini-card">
          <span class="tool-mini-icon">🔠</span>
          <div class="tool-mini-info">
            <h3>Case Converter</h3>
            <p>Convert to UPPERCASE, camelCase, snake_case & Title Case.</p>
          </div>
        </a>

        <a href="/tools/unit-converter" class="tool-mini-card">
          <span class="tool-mini-icon">📐</span>
          <div class="tool-mini-info">
            <h3>Unit Converter</h3>
            <p>Convert length, weight, temperature, area & storage units.</p>
          </div>
        </a>

        <a href="/tools/currency-converter" class="tool-mini-card">
          <span class="tool-mini-icon">💱</span>
          <div class="tool-mini-info">
            <h3>Currency Converter</h3>
            <p>Live ECB FX rates for USD, EUR, GBP, INR with local cache.</p>
          </div>
        </a>

        <a href="/tools/image-to-pdf" class="tool-mini-card">
          <span class="tool-mini-icon">🖼️</span>
          <div class="tool-mini-info">
            <h3>Image to PDF</h3>
            <p>Batch merge JPG, PNG & WEBP photos into a single PDF.</p>
          </div>
        </a>

        <a href="/tools/pdf-to-word" class="tool-mini-card">
          <span class="tool-mini-icon">📄</span>
          <div class="tool-mini-info">
            <h3>PDF to Word</h3>
            <p>Extract text and convert PDF documents to editable DOCX.</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Editorial Field Note & Newsletter Section -->
  <Newsletter />
</BaseLayout>

<style>
  .masthead-section {
    padding: 3.5rem 0 1.5rem;
  }

  .masthead-meta {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-faint);
    letter-spacing: 0.08em;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .masthead-tag {
    color: var(--color-accent);
    font-weight: 600;
  }

  .masthead-divider {
    opacity: 0.4;
  }

  .masthead-content {
    max-width: 960px;
    margin-bottom: 2.5rem;
  }

  .masthead-title {
    font-family: var(--font-serif);
    font-size: clamp(2.3rem, 5vw, 3.8rem);
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.025em;
    margin-bottom: 1.25rem;
  }

  .masthead-mission {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--color-text-muted);
    line-height: 1.6;
    max-width: 740px;
    font-family: var(--font-sans);
  }

  .masthead-rule {
    height: 1px;
    background: var(--color-border);
    width: 100%;
  }

  .section-kicker-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .kicker-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--color-accent);
    white-space: nowrap;
  }

  .kicker-line {
    flex-grow: 1;
    height: 1px;
    background: var(--color-border);
  }

  .lead-story-section {
    padding: 2rem 0;
  }

  .topic-index-section {
    padding: 1.5rem 0 2rem;
  }

  .dispatches-section {
    padding: 2rem 0 3.5rem;
  }

  .asymmetric-feed {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .spotlight-block {
    width: 100%;
  }

  .secondary-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 768px) {
    .secondary-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .tools-showcase-section {
    padding: 2.5rem 0 3.5rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .tools-showcase-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .showcase-title {
    font-family: var(--font-serif);
    font-size: clamp(1.65rem, 3vw, 2.2rem);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.25rem;
  }

  .showcase-subtitle {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .btn-tools-all {
    font-size: 0.85rem;
    padding: 0.5rem 1rem;
  }

  .tools-mini-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .tools-mini-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .tools-mini-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .tool-mini-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.65rem;
    padding: 1.25rem;
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .tool-mini-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-accent);
    box-shadow: 0 6px 18px var(--color-shadow);
  }

  .tool-mini-icon {
    font-size: 1.85rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .tool-mini-info {
    display: flex;
    flex-direction: column;
  }

  .tool-mini-info h3 {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.25rem;
  }

  .tool-mini-info p {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    line-height: 1.45;
    margin: 0;
  }
</style>

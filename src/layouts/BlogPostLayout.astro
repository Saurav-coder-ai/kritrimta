---
import BaseLayout from './BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { formatDate, getCategorySlug } from '@/utils/helpers';
import { getReadingTime, formatReadingTime } from '@/utils/reading-time';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  author: string;
  category: string;
  tags: string[];
  featured: boolean;
  body: string;
}

const { title, description, pubDate, updatedDate, heroImage, author = 'Saurav Karki', category, tags = [], featured, body = '' } = Astro.props;
const readingTime = getReadingTime(body);

// Get related posts (same category, excluding current)
const allPosts = await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft);
const relatedPosts = allPosts
  .filter(post => post.data.category === category && post.data.title !== title)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

// Schema.org JSON-LD
const schemaOrg = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  image: heroImage ? new URL(heroImage, Astro.site).toString() : undefined,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate || pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: author,
    jobTitle: 'Technology Writer & Editor',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Kritrimta',
    logo: {
      '@type': 'ImageObject',
      url: new URL('/favicon.svg', Astro.site).toString(),
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': Astro.url.toString(),
  },
};
---

<BaseLayout
  title={title}
  description={description}
  image={heroImage}
  type="article"
  publishedDate={pubDate}
  modifiedDate={updatedDate}
  author={author}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />

  <article class="article-wrapper">
    <header class="article-header">
      <div class="container header-container">
        <div class="article-meta-top">
          <a href={`/category/${getCategorySlug(category)}`} class="article-category-badge">
            {category}
          </a>
          <span class="meta-separator">&bull;</span>
          <time datetime={pubDate.toISOString()} class="article-date">
            {formatDate(pubDate)}
          </time>
          <span class="meta-separator">&bull;</span>
          <span class="article-read-time">
            <svg class="meta-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            {formatReadingTime(readingTime)}
          </span>
        </div>

        <h1 class="article-title">{title}</h1>
        
        {description && (
          <p class="article-lead">{description}</p>
        )}

        <div class="author-bar">
          <div class="author-avatar">{author.charAt(0)}</div>
          <div class="author-details">
            <span class="author-name">Written by <strong>{author}</strong></span>
            <span class="author-role">Chief Editor, Kritrimta</span>
          </div>
          {updatedDate && (
            <span class="updated-notice">
              Updated on {formatDate(updatedDate)}
            </span>
          )}
        </div>
      </div>
    </header>

    {heroImage && (
      <div class="container hero-container">
        <figure class="article-cover">
          <img
            src={heroImage}
            alt={title}
            loading="eager"
            width="1200"
            height="630"
            class="cover-img"
          />
        </figure>
      </div>
    )}

    <div class="container article-body-container">
      <div class="prose">
        <slot />
      </div>

      {tags && tags.length > 0 && (
        <footer class="article-tags-section">
          <span class="tags-header">INDEXED TOPICS:</span>
          <div class="tags-row">
            {tags.map(tag => (
              <a href={`/tags/${tag.toLowerCase().replace(/\s+/g, '-')}`} class="editorial-tag">
                #{tag}
              </a>
            ))}
          </div>
        </footer>
      )}
    </div>

    {relatedPosts.length > 0 && (
      <section class="related-section">
        <div class="container">
          <div class="related-header">
            <span class="related-kicker">EXPLORE FURTHER</span>
            <h2>Related Coverage in {category}</h2>
          </div>
          <div class="related-grid">
            {relatedPosts.map(post => (
              <PostCard
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                heroImage={post.data.heroImage}
                category={post.data.category}
                slug={post.id}
                body={post.body || ''}
                author={post.data.author}
                layout="standard"
              />
            ))}
          </div>
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .article-wrapper {
    padding-bottom: 3rem;
  }

  .article-header {
    padding: 3rem 0 2rem;
    border-bottom: 1px solid var(--color-border-subtle);
    background-color: var(--color-surface);
  }

  .header-container {
    max-width: 820px;
    margin: 0 auto;
  }

  .article-meta-top {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .article-category-badge {
    background: var(--color-accent-subtle);
    color: var(--color-accent);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }

  .article-category-badge:hover {
    background: var(--color-accent);
    color: #ffffff;
    text-decoration: none;
  }

  .article-read-time {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .meta-icon {
    color: var(--color-accent);
  }

  .meta-separator {
    color: var(--color-border);
  }

  .article-title {
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    line-height: 1.15;
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }

  .article-lead {
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
    font-family: var(--font-serif);
    font-style: italic;
  }

  .author-bar {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border-subtle);
    flex-wrap: wrap;
  }

  .author-avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-accent), #8b5cf6);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.05rem;
  }

  .author-details {
    display: flex;
    flex-direction: column;
  }

  .author-name {
    font-size: 0.95rem;
    color: var(--color-text);
  }

  .author-role {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }

  .updated-notice {
    margin-left: auto;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .hero-container {
    max-width: 960px;
    margin: 2.5rem auto 3rem;
  }

  .article-cover {
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
    box-shadow: 0 8px 30px var(--color-shadow);
  }

  .cover-img {
    width: 100%;
    height: auto;
    max-height: 520px;
    object-fit: cover;
  }

  .article-body-container {
    max-width: 820px;
    margin: 0 auto;
    padding-top: 1rem;
  }

  .article-tags-section {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .tags-header {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.1em;
  }

  .tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .editorial-tag {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.35rem 0.75rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    color: var(--color-text);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .editorial-tag:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: var(--color-accent-subtle);
  }

  .related-section {
    margin-top: 4.5rem;
    padding: 3.5rem 0;
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
  }

  .related-header {
    margin-bottom: 2rem;
  }

  .related-kicker {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.12em;
    display: block;
    margin-bottom: 0.35rem;
  }

  .related-header h2 {
    font-size: 1.75rem;
    margin: 0;
  }

  .related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 680px) {
    .related-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

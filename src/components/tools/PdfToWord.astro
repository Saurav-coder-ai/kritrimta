---
// PdfToWord.astro - Tier 1 Client-Side PDF to Word (DOCX) Converter
---

<div class="pdf-to-word-app">
  <!-- Tier 1 Quality Disclaimer Notice -->
  <div class="quality-notice-banner">
    <div class="notice-icon">ℹ️</div>
    <div class="notice-content">
      <strong>Tier 1 Client-Side Conversion:</strong> Best suited for text-based PDFs, reports, articles, and research papers. Complex vector layouts, custom multi-column templates, and embedded mathematical formulas may be flattened into clean editable paragraphs.
    </div>
  </div>

  <!-- Upload Dropzone -->
  <div class="dropzone-area" id="pdf-dropzone">
    <input
      type="file"
      id="pdf-file-input"
      accept="application/pdf"
      class="file-input-hidden"
    />
    <div class="dropzone-content">
      <div class="dropzone-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
          <polyline points="10 9 9 9 8 9"></polyline>
        </svg>
      </div>
      <p class="dropzone-prompt"><strong>Click to select a PDF file</strong> or drag and drop here</p>
      <p class="dropzone-note">Maximum recommended file size: 25MB (100% Client-Side Private)</p>
    </div>
  </div>

  <!-- Selected PDF File Metadata Card -->
  <div class="selected-pdf-card" id="pdf-meta-card" style="display: none;">
    <div class="file-icon-badge">PDF</div>
    <div class="file-details">
      <span class="file-name" id="pdf-file-name">document.pdf</span>
      <span class="file-info" id="pdf-file-stats">Calculating pages...</span>
    </div>
    <button type="button" class="btn-tool-action danger" id="pdf-remove-btn" title="Remove PDF">✕ Remove</button>
  </div>

  <!-- Progress Bar Container -->
  <div id="pdf-progress-container" class="progress-box" style="display: none;">
    <div class="progress-bar-bg">
      <div id="pdf-progress-bar" class="progress-bar-fill"></div>
    </div>
    <span id="pdf-progress-label" class="progress-label">Extracting text from PDF...</span>
  </div>

  <!-- Error / Warning Box -->
  <div id="pdf-warning-box" class="warning-box" style="display: none;"></div>

  <!-- Action Controls -->
  <div class="convert-actions-bar">
    <button type="button" id="pdf-convert-btn" class="btn btn-primary btn-convert-docx" disabled>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
        <polyline points="14 2 14 8 20 8"></polyline>
        <line x1="12" y1="18" x2="12" y2="12"></line>
        <line x1="9" y1="15" x2="15" y2="15"></line>
      </svg>
      <span>Convert to Word (.docx) &amp; Download</span>
    </button>
  </div>
</div>

<style>
  .pdf-to-word-app {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .quality-notice-banner {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 0.85rem 1rem;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .notice-icon {
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .notice-content strong {
    color: var(--color-text);
  }

  .dropzone-area {
    border: 2px dashed var(--color-border);
    border-radius: 0.75rem;
    padding: 2.75rem 1.5rem;
    text-align: center;
    background: var(--color-bg);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .dropzone-area:hover,
  .dropzone-area.drag-over {
    border-color: var(--color-accent);
    background: var(--color-accent-subtle);
  }

  .file-input-hidden {
    display: none;
  }

  .dropzone-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }

  .dropzone-icon {
    color: var(--color-accent);
    margin-bottom: 0.25rem;
  }

  .dropzone-prompt {
    font-size: 1.05rem;
    color: var(--color-text);
  }

  .dropzone-note {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .selected-pdf-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: 0.6rem;
    padding: 1rem 1.25rem;
  }

  .file-icon-badge {
    background: var(--color-accent);
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.4rem 0.65rem;
    border-radius: 0.4rem;
    letter-spacing: 0.05em;
  }

  .file-details {
    display: flex;
    flex-direction: column;
    flex: 1;
    overflow: hidden;
  }

  .file-name {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .file-info {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .btn-tool-action {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    padding: 0.35rem 0.75rem;
    border-radius: 0.4rem;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-tool-action.danger:hover {
    border-color: #ef4444;
    color: #ef4444;
  }

  .warning-box {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid #ef4444;
    color: #ef4444;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    font-size: 0.85rem;
  }

  .progress-box {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .progress-bar-bg {
    width: 100%;
    height: 8px;
    background: var(--color-surface-subtle);
    border-radius: 9999px;
    overflow: hidden;
  }

  .progress-bar-fill {
    height: 100%;
    width: 0%;
    background: var(--color-accent);
    transition: width 0.2s ease;
  }

  .progress-label {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-muted);
    text-align: center;
  }

  .convert-actions-bar {
    display: flex;
    justify-content: center;
  }

  .btn-convert-docx {
    width: 100%;
    max-width: 400px;
    padding: 0.85rem 1.5rem;
    font-size: 1rem;
  }

  .btn-convert-docx:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none !important;
  }
</style>

<script>
  let currentFile: File | null = null;
  let fileBuffer: ArrayBuffer | null = null;

  const dropzone = document.getElementById('pdf-dropzone');
  const fileInput = document.getElementById('pdf-file-input') as HTMLInputElement | null;
  const metaCard = document.getElementById('pdf-meta-card');
  const fileNameEl = document.getElementById('pdf-file-name');
  const fileStatsEl = document.getElementById('pdf-file-stats');
  const removeBtn = document.getElementById('pdf-remove-btn');
  const convertBtn = document.getElementById('pdf-convert-btn') as HTMLButtonElement | null;
  const warningBox = document.getElementById('pdf-warning-box');
  const progressContainer = document.getElementById('pdf-progress-container');
  const progressBar = document.getElementById('pdf-progress-bar');
  const progressLabel = document.getElementById('pdf-progress-label');

  function formatBytes(bytes: number): string {
    if (bytes < 1024) return `${bytes} B`;
    if (bytes < 1048576) return `${(bytes / 1024).toFixed(1)} KB`;
    return `${(bytes / 1048576).toFixed(1)} MB`;
  }

  function showWarning(msg: string | null) {
    if (!warningBox) return;
    if (msg) {
      warningBox.textContent = msg;
      warningBox.style.display = 'block';
    } else {
      warningBox.style.display = 'none';
    }
  }

  async function handleSelectedFile(file: File) {
    showWarning(null);
    if (file.type !== 'application/pdf' && !file.name.toLowerCase().endsWith('.pdf')) {
      showWarning('Invalid file format. Please select a valid PDF (.pdf) document.');
      return;
    }

    currentFile = file;
    fileBuffer = await file.arrayBuffer();

    if (fileNameEl) fileNameEl.textContent = file.name;
    if (fileStatsEl) fileStatsEl.textContent = `${formatBytes(file.size)} &bull; Ready for conversion`;
    if (metaCard) metaCard.style.display = 'flex';
    if (convertBtn) convertBtn.disabled = false;
  }

  dropzone?.addEventListener('click', () => fileInput?.click());

  fileInput?.addEventListener('change', (e) => {
    const target = e.target as HTMLInputElement;
    if (target.files && target.files[0]) {
      handleSelectedFile(target.files[0]);
      target.value = '';
    }
  });

  dropzone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.classList.add('drag-over');
  });

  ['dragleave', 'dragend'].forEach(type => {
    dropzone?.addEventListener(type, () => dropzone.classList.remove('drag-over'));
  });

  dropzone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('drag-over');
    if (e.dataTransfer && e.dataTransfer.files.length > 0) {
      handleSelectedFile(e.dataTransfer.files[0]);
    }
  });

  removeBtn?.addEventListener('click', () => {
    currentFile = null;
    fileBuffer = null;
    if (metaCard) metaCard.style.display = 'none';
    if (convertBtn) convertBtn.disabled = true;
    showWarning(null);
  });

  // Convert PDF to DOCX using pdfjs-dist and docx
  async function convertPdfToDocx() {
    if (!currentFile || !fileBuffer || !convertBtn || !progressContainer || !progressBar || !progressLabel) return;

    convertBtn.disabled = true;
    progressContainer.style.display = 'flex';
    progressBar.style.width = '10%';
    progressLabel.textContent = 'Initializing PDF reader and document generator...';

    try {
      // 1. Load pdfjs-dist
      let pdfjsLib: any = null;
      try {
        pdfjsLib = await import('pdfjs-dist');
        // Set worker src from unpkg CDN for reliable client worker execution
        if (pdfjsLib.GlobalWorkerOptions) {
          pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://unpkg.com/pdfjs-dist@4.5.136/build/pdf.worker.min.mjs';
        }
      } catch (importErr) {
        // Fallback to global if present
        pdfjsLib = (window as any).pdfjsLib;
        if (!pdfjsLib) throw new Error('Could not initialize PDF parsing engine.');
      }

      progressBar.style.width = '25%';
      progressLabel.textContent = 'Parsing PDF structure and extracting text...';

      // 2. Load PDF document
      const loadingTask = pdfjsLib.getDocument({ data: new Uint8Array(fileBuffer) });
      const pdf = await loadingTask.promise;
      const totalPages = pdf.numPages;

      const extractedPagesText: string[][] = [];

      for (let pageNum = 1; pageNum <= totalPages; pageNum++) {
        const page = await pdf.getPage(pageNum);
        const textContent = await page.getTextContent();
        
        const pageLines: string[] = [];
        let currentLine = '';
        let lastY: number | null = null;

        for (const item of textContent.items as any[]) {
          if (!item.str) continue;
          const y = item.transform ? item.transform[5] : 0;

          if (lastY !== null && Math.abs(y - lastY) > 5) {
            if (currentLine.trim()) {
              pageLines.push(currentLine.trim());
            }
            currentLine = item.str;
          } else {
            currentLine += (currentLine.length > 0 && !currentLine.endsWith(' ') ? ' ' : '') + item.str;
          }
          lastY = y;
        }

        if (currentLine.trim()) {
          pageLines.push(currentLine.trim());
        }

        extractedPagesText.push(pageLines);

        const pct = Math.round(25 + (pageNum / totalPages) * 45);
        progressBar.style.width = `${pct}%`;
        progressLabel.textContent = `Extracted page ${pageNum} of ${totalPages}...`;
      }

      progressBar.style.width = '75%';
      progressLabel.textContent = 'Building Microsoft Word (.docx) document...';

      // 3. Build DOCX document using docx library
      const { Document, Packer, Paragraph, TextRun, HeadingLevel } = await import('docx');

      const docSections = extractedPagesText.map((lines, pageIdx) => {
        const paragraphs = [];

        // Add page header / number indicator if multi-page
        if (totalPages > 1) {
          paragraphs.push(
            new Paragraph({
              children: [
                new TextRun({
                  text: `Page ${pageIdx + 1}`,
                  color: '888888',
                  size: 18,
                  italics: true
                })
              ]
            })
          );
        }

        for (const line of lines) {
          // Check if line looks like a heading
          const isShort = line.length < 80;
          const isUppercase = line === line.toUpperCase() && line.length > 3 && /[A-Z]/.test(line);

          if (isShort && (isUppercase || /^[0-9]+\.\s+[A-Z]/.test(line))) {
            paragraphs.push(
              new Paragraph({
                text: line,
                heading: HeadingLevel.HEADING_2,
                spacing: { before: 240, after: 120 }
              })
            );
          } else {
            paragraphs.push(
              new Paragraph({
                children: [new TextRun({ text: line, size: 22 })],
                spacing: { after: 120 }
              })
            );
          }
        }

        return {
          children: paragraphs
        };
      });

      const docxDoc = new Document({
        creator: 'Kritrimta Tools',
        title: currentFile.name.replace(/\.pdf$/i, ''),
        description: 'Converted from PDF by Kritrimta Tools',
        sections: docSections
      });

      progressBar.style.width = '90%';
      progressLabel.textContent = 'Packing DOCX archive...';

      const docxBlob = await Packer.toBlob(docxDoc);

      // Download file
      const downloadUrl = URL.createObjectURL(docxBlob);
      const downloadLink = document.createElement('a');
      downloadLink.href = downloadUrl;
      const baseName = currentFile.name.replace(/\.pdf$/i, '') || 'converted_document';
      downloadLink.download = `${baseName}.docx`;
      document.body.appendChild(downloadLink);
      downloadLink.click();
      document.body.removeChild(downloadLink);
      URL.revokeObjectURL(downloadUrl);

      progressBar.style.width = '100%';
      progressLabel.textContent = 'Conversion complete! Download started.';

      setTimeout(() => {
        progressContainer.style.display = 'none';
        convertBtn.disabled = false;
        progressBar.style.width = '0%';
      }, 2500);

    } catch (err: any) {
      console.error('PDF to Word Error', err);
      showWarning(`Conversion Error: ${err?.message || 'Failed to extract text from PDF.'}`);
      progressContainer.style.display = 'none';
      convertBtn.disabled = false;
    }
  }

  convertBtn?.addEventListener('click', convertPdfToDocx);
</script>

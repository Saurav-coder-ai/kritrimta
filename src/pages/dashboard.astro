---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SplineSceneBasic } from '@/components/ui/demo';
import { Card, CardHeader, CardTitle, CardDescription, CardContent } from '@/components/ui/card';

const telemetryMetrics = [
  {
    label: 'Speculative Decoding Speedup',
    value: '2.84x',
    delta: '+18% vs baseline',
    note: 'Draft model verification on Apple M4 Max',
    icon: '⚡',
  },
  {
    label: 'Edge Inference Latency',
    value: '14.2 ms',
    delta: '-32% overhead',
    note: 'Quantized INT4 weights running in WebAssembly',
    icon: '⏱️',
  },
  {
    label: 'Client-Side Privacy Isolation',
    value: '100%',
    delta: 'Zero cloud telemetry',
    note: 'All document & conversion tools run strictly locally',
    icon: '🛡️',
  },
  {
    label: 'Active Utility Engines',
    value: '8 Modules',
    delta: 'Online & Cached',
    note: 'PDF, Docx, FX Rates, Text & Unit Converters',
    icon: '🧰',
  },
];

const featuredTools = [
  { name: 'Word Counter', slug: 'word-counter', icon: '📝', desc: 'Real-time WPM, reading time, and keyword density.' },
  { name: 'Currency Converter', slug: 'currency-converter', icon: '💱', desc: 'Live ECB foreign exchange rates with local offline cache.' },
  { name: 'Image to PDF', slug: 'image-to-pdf', icon: '🖼️', desc: 'Merge JPG, PNG, WEBP into custom PDF documents.' },
  { name: 'PDF to Word', slug: 'pdf-to-word', icon: '📄', desc: 'Client-side PDF text extraction to clean DOCX files.' },
];
---

<BaseLayout
  title="Autonomous Systems & Computational Dashboard — Kritrimta"
  description="Real-time interactive 3D computing lab, empirical AI performance telemetry, and client-side utility suite."
>
  <div class="dashboard-page-wrapper">
    <div class="container">
      <!-- Breadcrumb -->
      <nav class="dashboard-breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li class="crumb-sep">/</li>
          <li aria-current="page">Dashboard</li>
        </ol>
      </nav>

      <!-- Dashboard Header -->
      <header class="dashboard-header">
        <div class="dashboard-badge">KRITRIMTA COMPUTATIONAL TELEMETRY // EST. 2026</div>
        <h1 class="dashboard-title">
          Engineering &amp; <span class="accent-gradient">Interactive Lab</span>
        </h1>
        <p class="dashboard-subtitle">
          Real-time 3D simulation, speculative decoding empirical benchmarks, and private client-side utilities built for modern engineering workflows.
        </p>
      </header>

      <!-- 3D Interactive Spline Showcase Card -->
      <section class="dashboard-showcase">
        <div class="section-kicker-bar">
          <span class="kicker-label">INTERACTIVE 3D SIMULATION</span>
          <span class="kicker-line"></span>
          <span class="kicker-badge">SPLINE + WEBGL</span>
        </div>
        <SplineSceneBasic
          client:only="react"
          badge="Autonomous Agent Core"
          title="Interactive 3D"
          description="Bring your UI to life with beautiful 3D scenes. Create immersive experiences that capture attention and enhance your design."
          ctaText="View AI Dispatches &rarr;"
          ctaLink="/category/ai-tools"
        />
      </section>

      <!-- Telemetry Cards Grid -->
      <section class="telemetry-section">
        <div class="section-kicker-bar">
          <span class="kicker-label">SYSTEM TELEMETRY & EMPIRICAL BENCHMARKS</span>
          <span class="kicker-line"></span>
        </div>

        <div class="telemetry-grid">
          {telemetryMetrics.map((metric) => (
            <Card className="telemetry-card bg-surface border-border">
              <CardHeader className="p-5 pb-2">
                <div class="flex items-center justify-between">
                  <span class="text-2xl">{metric.icon}</span>
                  <span class="text-xs font-mono text-emerald-500 font-semibold">{metric.delta}</span>
                </div>
                <CardTitle className="text-sm font-medium text-muted-foreground mt-3">
                  {metric.label}
                </CardTitle>
              </CardHeader>
              <CardContent className="p-5 pt-0">
                <div class="text-3xl font-serif font-bold text-foreground mt-1">
                  {metric.value}
                </div>
                <CardDescription className="text-xs text-muted-foreground mt-2 leading-relaxed">
                  {metric.note}
                </CardDescription>
              </CardContent>
            </Card>
          ))}
        </div>
      </section>

      <!-- Quick Launch Utilities Grid -->
      <section class="launchpad-section">
        <div class="section-kicker-bar">
          <span class="kicker-label">CLIENT-SIDE TOOL LAUNCHPAD</span>
          <span class="kicker-line"></span>
          <a href="/tools" class="kicker-link">All 8 Tools &rarr;</a>
        </div>

        <div class="launchpad-grid">
          {featuredTools.map((tool) => (
            <a href={`/tools/${tool.slug}`} class="launchpad-card">
              <span class="launchpad-icon">{tool.icon}</span>
              <div class="launchpad-content">
                <h3 class="launchpad-name">{tool.name}</h3>
                <p class="launchpad-desc">{tool.desc}</p>
              </div>
              <span class="launchpad-arrow">&rarr;</span>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .dashboard-page-wrapper {
    padding: 2rem 0 5rem;
  }

  .dashboard-breadcrumbs ol {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    font-size: 0.85rem;
    color: var(--color-text-faint);
  }

  .dashboard-breadcrumbs a {
    color: var(--color-text-muted);
  }

  .dashboard-breadcrumbs a:hover {
    color: var(--color-accent);
  }

  .crumb-sep {
    color: var(--color-border);
  }

  .dashboard-header {
    margin-bottom: 2.75rem;
  }

  .dashboard-badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--color-accent);
    margin-bottom: 0.85rem;
    font-weight: 600;
  }

  .dashboard-title {
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 4.5vw, 3.5rem);
    line-height: 1.15;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .dashboard-subtitle {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    max-width: 720px;
    line-height: 1.6;
  }

  .section-kicker-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .kicker-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--color-accent);
    white-space: nowrap;
  }

  .kicker-line {
    flex-grow: 1;
    height: 1px;
    background: var(--color-border);
  }

  .kicker-badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    background: rgba(224, 83, 43, 0.1);
    color: var(--color-accent);
    border: 1px solid rgba(224, 83, 43, 0.25);
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .kicker-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-accent);
    text-decoration: none;
    white-space: nowrap;
  }

  .kicker-link:hover {
    text-decoration: underline;
  }

  .dashboard-showcase {
    margin-bottom: 3.5rem;
  }

  .telemetry-section {
    margin-bottom: 3.5rem;
  }

  .telemetry-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .telemetry-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .telemetry-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .launchpad-section {
    margin-bottom: 2rem;
  }

  .launchpad-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .launchpad-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .launchpad-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .launchpad-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem;
    border-radius: 0.75rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .launchpad-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-accent);
    box-shadow: 0 8px 24px var(--color-shadow);
  }

  .launchpad-icon {
    font-size: 2rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .launchpad-content {
    flex: 1;
    min-width: 0;
  }

  .launchpad-name {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.2rem;
  }

  .launchpad-desc {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    line-height: 1.4;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .launchpad-arrow {
    color: var(--color-accent);
    font-size: 1.25rem;
    transition: transform 0.2s ease;
  }

  .launchpad-card:hover .launchpad-arrow {
    transform: translateX(4px);
  }
</style>
